{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../..",
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["./index.ts", "../../server/**/*.ts"]
}
