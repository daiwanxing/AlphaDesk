{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "rootDir": ".",
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.cloudfunctions.tsbuildinfo"
  },
  "include": ["./**/*.ts"],
  "exclude": ["./get-events/**"]
}
