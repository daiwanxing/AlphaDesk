{
  "name": "alphadesk",
  "version": "0.0.0",
  "private": true,
  "description": "AlphaDesk Terminal — 信息聚合投研终端（事件追踪 / A 股量能）",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf:build": "node scripts/build-cloudfunctions.mjs",
    "cf:clean": "node scripts/build-cloudfunctions.mjs clean",
    "cf:typecheck": "tsc -p cloudfunctions/tsconfig.json --noEmit",
    "build:cloudbase": "vite build --mode production",
    "deploy:cloudbase": "pnpm build:cloudbase && bash scripts/deploy-cloudbase.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "sass": "^1.102.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,scss,css,html,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.13.2"
}
