# 本地开发（复制为 .env.local）
# 时间线 HTTP（get-events）；留空则走 Vite 同源 /api 中间件
# 直连云端示例：https://<envId>-xxxx.tcloudbaseapp.com/get-events
# 本地备选同源代理：/cloudbase-events（见 vite.config.ts）
VITE_CLOUDBASE_EVENTS_URL=
# CloudBase AI 解读
VITE_CLOUDBASE_BRIEFS_URL=
VITE_CLOUDBASE_BACKFILL_URL=
VITE_CLOUDBASE_TURNOVER_URL=
# 生产示例：
# VITE_CLOUDBASE_TURNOVER_URL=https://trader-d4gl4d7a1cb6baebb-1301814349.tcloudbaseapp.com/get-market-turnover
# 与云函数环境变量 BRIEF_API_KEY 一致（浏览器可见，仅单用户）
VITE_BRIEF_API_KEY=

# CloudBase 静态托管生产构建见 .env.production.cloudbase.example
