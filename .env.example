# 本地开发（复制为 .env.local）
#
# CloudBase HTTP 网关 base（一个变量覆盖全部 HTTP 云函数）
# - 留空：时间线走 Vite 同源 /api 中间件；briefs/backfill/turnover 不可用
# - 本地同源代理：/cloudbase（见 vite.config.ts）
# - 直连云端：https://<envId>-xxxx.tcloudbaseapp.com
VITE_CLOUDBASE_API_BASE=
# 与云函数环境变量 BRIEF_API_KEY 一致（浏览器可见，仅单用户）
VITE_BRIEF_API_KEY=

# CloudBase 静态托管生产构建见 .env.production.cloudbase.example
